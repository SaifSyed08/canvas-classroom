{
  "manifest_version": 3,
  "name": "Canvas Classroom",
  "version": "0.2.0",
  "description": "Canvas, Classroom-style: a class rail, Classwork, one To-do list, files that open in place, an AI that knows your classes and a pet.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://*.instructure.com/*",
    "https://*.inscloudgate.net/*",
    "https://*.amazonaws.com/*",
    "https://codex-pets.net/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "exclude_matches": [
        "https://canvadocs.instructure.com/*",
        "https://*.inscloudgate.net/*"
      ],
      "css": [
        "classroom.css",
        "fileview.css",
        "ai.css",
        "assignment.css",
        "people.css",
        "pets.css",
        "suggest.css"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "exclude_matches": [
        "https://canvadocs.instructure.com/*",
        "https://*.inscloudgate.net/*"
      ],
      "js": [
        "classroom.js",
        "pets.js",
        "assignment.js",
        "people.js",
        "fileview.js",
        "ai.js",
        "suggest.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*.instructure.com/*"
      ]
    },
    {
      "resources": [
        "viewer/*"
      ],
      "matches": [
        "https://*.instructure.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
