{
  "manifest_version": 3,
  "name": "Canvas Classroom",
  "version": "0.1.0",
  "description": "Google Classroom-style layout for Canvas. Runs on top of BetterCampus.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*"],
      "exclude_matches": ["https://canvadocs.instructure.com/*", "https://*.inscloudgate.net/*"],
      "css": ["classroom.css"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.instructure.com/*"],
      "exclude_matches": ["https://canvadocs.instructure.com/*", "https://*.inscloudgate.net/*"],
      "js": ["classroom.js"],
      "run_at": "document_end"
    }
  ]
}
